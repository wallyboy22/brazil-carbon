function landtrendr (col,_years){

  //////////////////////////////////// LandTrendr
  var run_params = { 
    timeSeries:             col,    // timeSeries (ImageCollection): Yearly time-series from which to extract breakpoints. The first band is usedto find breakpoints, and all subsequent bands are fitted using those breakpoints.
    maxSegments:            6,      // maxSegments (Integer): Maximum number of segments to be fitted on the time series.
    spikeThreshold:         0.9,    // spikeThreshold (Float, default: 0.9): Threshold for dampening the spikes (1.0 means no dampening).
    vertexCountOvershoot:   3,      // vertexCountOvershoot (Integer, default: 3): The initial model can overshoot the maxSegments + 1 vertices by this amount. Later, it will be pruned down to maxSegments + 1.
    preventOneYearRecovery: true,   // preventOneYearRecovery (Boolean, default: false): Prevent segments that represent one year recoveries.
    recoveryThreshold:      0.25,   // recoveryThreshold (Float, default: 0.25): If a segment has a recovery rate faster than 1/recoveryThreshold (in years), then the segment is disallowed.
    pvalThreshold:          0.05,   // pvalThreshold (Float, default: 0.1): If the p-value of the fitted model exceeds this threshold, then the current model is discarded and another one is fitted using the Levenberg-Marquardt optimizer.
    bestModelProportion:    0.75,   // bestModelProportion (Float, default: 0.75): Allows models with more vertices to be chosen if their p-value is no more than (2 - bestModelProportion) times the p-value of the best model.
    minObservationsNeeded:  6       // minObservationsNeeded (Integer, default: 6): Min observations needed to perform output fitting.
  };

  // rodando o algoritimo de segmentação temporal
  var LTresult = ee.Algorithms.TemporalSegmentation.LandTrendr(run_params).toFloat();
  print('LTresult',LTresult)
  // destacando 
  var LTarray = LTresult.select(['LandTrendr']); // subset the LandTrendr segmentation info

  // o nbr landtrandr é o principal resultado deste processamento
  var nbr_landtrandr = LTarray.arraySlice({
      axis:0,
      start:2,
      end:3,
    }).arrayProject([1]); //slice out the fitted values row

  // var vectors_landtrandr = LTarray.arraySlice({
  //     axis:0,
  //     start:3,
  //     end:4,
  //   }); //slice out the fitted values row

  
  var list_images_multibands = bands
    .map(function(bandname){
  
     var ftv = LTresult.select([bandname + '_fit']).byte(); // subset the bandname_fit band
     
     if (bandname === bands[0]){
      // nbr_fit
       ftv = nbr_landtrandr;
     }
     
      return ftv.arrayFlatten([_years]);
  });

  var col_annual_landtrandr = ee.ImageCollection(
    _years.map(function(year){
      var start = ee.Date(''+year+'-01-01');
      var end = start.advance(1,'year');
      
      var recipe = ee.Image().select();
      
      bands.forEach(function(bandname,i){
        recipe = recipe.addBands(list_images_multibands[i].select([year],[bandname]));
      });
      
      return recipe.set({
        'system:time_start':start.millis(),
        'system:time_end':end.millis(),
        'year':year,
      });
    })
  );
  
  
  return col_annual_landtrandr;
}

