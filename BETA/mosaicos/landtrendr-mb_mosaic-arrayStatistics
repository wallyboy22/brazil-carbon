// --- --- --- MAIN FUNCTIONS
function landtrendr (_run_params,_years,_bands){
  _years = _years.map(function(year){return ''+year});
  
  // rodando o algoritimo de segmentação temporal
  var LTresult = ee.Algorithms.TemporalSegmentation.LandTrendr(_run_params).toFloat();
  // print('LTresult',LTresult)
  // destacando 
  var LTarray = LTresult.select(['LandTrendr']); // subset the LandTrendr segmentation info

  var segmented_index = LTarray.arraySlice({
      axis:0,
      start:2,
      end:3,
    }).arrayProject([1]); //slice out the fitted values row

  var vertex_landtrandr = LTarray.arraySlice({
      axis:0,
      start:3,
      end:4,
    }).arrayProject([1]); //slice out the fitted values row


  _bands[_bands.length] = 'vertex';
  
  var list_images_multibands = _bands
    .map(function(bandname){
  
     var ftv = LTresult.select([bandname + '_fit']); // subset the bandname_fit band
     
     if (bandname === _bands[0]){
      // nbr_fit
       ftv = segmented_index;
     }
     if (bandname === 'vertex'){
      // nbr_fit
       ftv = vertex_landtrandr;
     }
     
      return ftv
        .byte()
        .arrayFlatten([_years]);
  });

  var col_annual_landtrandr = ee.ImageCollection(
    _years.map(function(year){
      var start = ee.Date(''+year+'-01-01');
      var end = start.advance(1,'year');
      
      var recipe = ee.Image().select();
      
      _bands.forEach(function(bandname,i){
        recipe = recipe.addBands(list_images_multibands[i].select([year],[bandname]));
      });
      
      return recipe.set({
        'system:time_start':start.millis(),
        'system:time_end':end.millis(),
        'year':parseInt(year),
      });
    })
  );
  
  var rmse = ee.Image(LTresult.select('rmse')).int16();
  
  return {collection:col_annual_landtrandr,rmse:rmse};
}

  
// --- --- --- DEVELOPMENT of annual mosaics and their temporal segmentation
var annual_mosaics = years.map(function(year){
  var start = ee.Date(''+year+'-01-01');
  var end = start.advance(1,'year');
  return mb_mosaics
    .filter(ee.Filter.eq('year',year))
    .filter(ee.Filter.inList('satellite',year_sat[year]))
    // .map(indexs_for_mb_mosaics)
    .median() // no caso de sobreposição de cartas entre os biomas, ou de mosaicos com mais de um ano, a redução calculando a mediana
    .divide(100)
    .byte()
    .unmask()
    .set({
      year:year,
      'system:time_start':start.millis(),
      'system:time_end':end.millis(),
    });
});

