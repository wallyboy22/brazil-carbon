var extractTimeSeries = function(imageCollection,region) {
  var timeSeries = ui.Chart.image.series({
    imageCollection: imageCollection,
    region: region,
    reducer: ee.Reducer.first(),
    scale: 500,
    xProperty: 'system:time_start'
  }).setOptions({
    title: 'Série Temporal',
    hAxis: {title: 'Data'},
    vAxis: {title: 'Refletância'},
    lineWidth: 1,
    // pointSize: 3,
    legend: {
      position: 'in',
      textStyle: {fontSize: 11 }
    },
    series: {
      0: { color: '0000ff', lineWidth: 1.5 }, 
      1: { color: '00ff00' },
      2: { color: 'ff0000' },  
      3: { color: '004040' },
      4: { color: 'aa00aa' },
      5: { color: 'ffaa00' },
    }
  });
  
  timeSeries.style().set({
    width:'600px',
  });
  
  return timeSeries;
};

