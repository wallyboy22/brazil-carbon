          var classe = ui.Label(value,{margin:'1px 0px 1px 0px',fontSize:'9px',textAlign:'center',stretch:'horizontal',backgroundColor:palette[value]});
  
          var yearBox = ui.Panel({
            widgets:[classe,year], 
            layout:ui.Panel.Layout.flow('vertical',true),
            style:{
              margin:'0px 1px 0px 1px',
              border:'1px dashed #00000020', // solid; /* ou dashed, dotted, double, groove, ridge, inset, outset, none */
              backgroundColor:palette[value]
            }
          });
  
          
