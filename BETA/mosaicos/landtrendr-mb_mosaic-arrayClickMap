function pixelHistory (point){
  
  var historys = ui.Panel({
    // widgets:
    layout:ui.Panel.Layout.flow('vertical',true),
    style:{margin:'0px'}
  });
  
  [
    ['LULC',mb_lulc8,lulc_vis,lulc_legend,],
    ['FIRE',mb_fire2.unmask(),fire_vis,fire_legend],
    ['TRAJ',nat_trajectory,trajetory_vis,trajetory_legend],
  ].forEach(function(list){
    var name = list[0];
    var img = list[1];
    var vis = list[2];
    var palette = vis.palette;
    var legend = list[3];
    
    var reduce = img.reduceRegion({
      reducer:ee.Reducer.first(),
      geometry:point,
      scale:30,
      // crs:,
      // crsTransform:,
      // bestEffort:,
      maxPixels:1e6,
      // tileScale:
    });

    var listLabels = ui.Panel({
      widgets:ui.Label(name,{margin:'0px',width:'40px'}), 
      layout:ui.Panel.Layout.flow('horizontal',true),
      style:{
        margin:'0px',
        border:'1px dashed #00000020', // solid; /* ou dashed, dotted, double, groove, ridge, inset, outset, none */
        textAlign:'center',
      }
    });
    
    reduce.keys().evaluate(function(keys){
      reduce.values().evaluate(function(values){
        keys.forEach(function(key,i){
          var value = values[i];


          var titulo = key === 'trajectories' ? legend.filter(function(obj){return obj.value === value})[0].label : key.slice(-2);
          // print('legend.filter(function(obj){obj.value === value})',legend.filter(function(obj){obj.value === value}));
