// Point at the EO datasets 
var ALOS1 = ee.ImageCollection('projects/mapbiomas-workspace/CARBONO/CERRADO_ALOSPALSAR1') //2006 a 2020
.map(function(img){
  return img.set({
    'year':ee.Number.parse(img.getString('system:index').slice(-4))
  });
});

var ALOS2 = ee.ImageCollection('projects/mapbiomas-workspace/CARBONO/CERRADO_ALOSPALSAR2') //2015 a 2022
.map(function(img){
  return img.set({
    'year':ee.Number.parse(img.getString('system:index').slice(-4))
  });
});

var ALOS = ee.List.sequence(2007,2022,1).iterate(function(current,previous){
  
  var year = ee.Number(current).int();
  var collection = ee.Algorithms.If({
    condition:year.gte(2015),
    trueCase:ALOS2,
    falseCase:ALOS1
  });
  
  var img = ee.ImageCollection(collection)
    .filter(ee.Filter.eq('year',year))
    .mosaic();
  
  // HH
  var ALOSHH = img.select(0).rename('ALOSHH');
  var ALOSHV = img.select(1).rename('ALOSHV');
  //Calculate Radar Forest Degradation Index
  var ALOSrfdi = img.select(0).subtract(img.select(1)).divide(img.select(0).add(img.select(1))).rename('ALOSrfdi');
  //Calculate cross-polarized ratio
  var ALOScpR = img.select(1).divide(img.select(0)).rename('ALOScpR');
  //var ALOSstack = ALOSHH.addBands(ALOSHV).addBands(ALOSrfdi).addBands(ALOScpR);
  
  var newimg = ee.Image().select()
    .addBands(ALOSHH)
    .addBands(ALOSHV)
    .addBands(ALOSrfdi)
    .addBands(ALOScpR)
    .set('year',year);
  
  return ee.List(previous).add(newimg);
},[]);
ALOS = ee.ImageCollection(ee.List(ALOS));

Map.addLayer(ALOS.first())
  // 'ALOSHH','ALOSHV',"ALOSrfdi","ALOScpR",


print('ALOS',ALOS)
var mb_mosaics = ee.ImageCollection('projects/nexgenmap/MapBiomas2/LANDSAT/BRAZIL/mosaics-2');
print('mb_bands',mb_mosaics.first().bandNames());

mb_mosaics = mb_mosaics.map(function(img){

    var gcvi_median = img.select('nir_median').divide(img.select('green_median').subtract(1)).rename('gcvi_median');
    var gcvi_median_dry = img.select('nir_median_dry').divide(img.select('green_median_dry').subtract(1)).rename('gcvi_median_dry');
    var gcvi_median_wet = img.select('nir_median_wet').divide(img.select('green_median_wet').subtract(1)).rename('gcvi_median_wet');
    
    var sr_median = img.select('nir_median').divide(img.select('green_median')).rename('sr_median');
    var sr_median_dry = img.select('nir_median_dry').divide(img.select('green_median_dry')).rename('sr_median_dry');
    var sr_median_wet = img.select('nir_median_wet').divide(img.select('green_median_wet')).rename('sr_median_wet');
    
    var gdvi1_median = sr_median.subtract(1).divide(sr_median.add(1)).rename('gdvi1_median');
    var gdvi1_median_dry = sr_median_dry.subtract(1).divide(sr_median_dry.add(1)).rename('gdvi1_median_dry');
    var gdvi1_median_wet = sr_median_wet.subtract(1).divide(sr_median_wet.add(1)).rename('gdvi1_median_wet');
    
    var ndmi_median = img.normalizedDifference(['nir_median','swir1_median']).rename('ndmi_median');
    var ndmi_median_dry = img.normalizedDifference(['nir_median_dry','swir1_median_dry']).rename('ndmi_median_dry');
    var ndmi_median_wet = img.normalizedDifference(['nir_median_wet','swir1_median_wet']).rename('ndmi_median_wet');
    
    var tcg_median = img.expression("(-0.2941 * blue_median) - (0.243 * green_median) - (0.5424 * red_median) + (0.7276 * nir_median) + (0.0713 * swir1_median) - (0.1608 * swir2_median)",{
      blue_median:img.select('blue_median'),
      green_median:img.select('green_median'),
      red_median:img.select('red_median'),
      nir_median:img.select('nir_median'),
      swir1_median:img.select('swir1_median'),
      swir2_median:img.select('swir2_median'),
      
    }).rename('tcg_median');
    var tcg_median_dry = img.expression("(-0.2941 * blue_median_dry) - (0.243 * green_median_dry) - (0.5424 * red_median_dry) + (0.7276 * nir_median_dry) + (0.0713 * swir1_median_dry) - (0.1608 * swir2_median_dry)",{
      blue_median_dry:img.select('blue_median_dry'),
      green_median_dry:img.select('green_median_dry'),
      red_median_dry:img.select('red_median_dry'),
      nir_median_dry:img.select('nir_median_dry'),
      swir1_median_dry:img.select('swir1_median_dry'),
      swir2_median_dry:img.select('swir2_median_dry'),
      
    }).rename('tcg_median_dry');
    var tcg_median_wet = img.expression("(-0.2941 * blue_median_wet) - (0.243 * green_median_wet) - (0.5424 * red_median_wet) + (0.7276 * nir_median_wet) + (0.0713 * swir1_median_wet) - (0.1608 * swir2_median_wet)",{
      blue_median_wet:img.select('blue_median_wet'),
      green_median_wet:img.select('green_median_wet'),
      red_median_wet:img.select('red_median_wet'),
      nir_median_wet:img.select('nir_median_wet'),
      swir1_median_wet:img.select('swir1_median_wet'),
      swir2_median_wet:img.select('swir2_median_wet'),
      
    }).rename('tcg_median_wet');

    return img
      .addBands(gcvi_median).addBands(gcvi_median_dry).addBands(gcvi_median_wet)
      .addBands(sr_median).addBands(sr_median_dry).addBands(sr_median_wet)
      .addBands(gdvi1_median).addBands(gdvi1_median_dry).addBands(gdvi1_median_wet)
      .addBands(ndmi_median).addBands(ndmi_median_dry).addBands(ndmi_median_wet)
      .addBands(tcg_median).addBands(tcg_median_dry).addBands(tcg_median_wet);
});


