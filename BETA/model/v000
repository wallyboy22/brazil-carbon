print(data.aggregate_array('Ano').distinct().sort());
//Extract EO signatures for training
var out = data.map(function(feat){

  var ano = feat.getNumber('Ano').int();
  ano = ee.Algorithms.If({
    condition:ano.lt(2007),
    trueCase:2007,
    falseCase:ano
  });
  ano = ee.Number(ano);
  
  var alos_year = ALOS.filter(ee.Filter.eq('year',ano)).mosaic();
  var mb_year = mb_mosaics.filter(ee.Filter.eq('year',ano)).mosaic();
 
  var img = ee.Image().select()
    .addBands(alos_year)
    .addBands(mb_year);
    
  var reduce = img.reduceRegion({
    reducer:ee.Reducer.mean(),
    geometry:feat.geometry(), 
    scale:30, 
    // crs:, crsTransform, bestEffort, 
    maxPixels:1e13,
    // tileScale:
  });
  
  return feat.set(reduce).copyProperties(feat);
});

