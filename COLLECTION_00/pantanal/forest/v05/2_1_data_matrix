/******************************************************************************
 * MAPBIOMAS-CARBONO — Pantanal v05 · Matriz em memória por célula
 * ---------------------------------------------------------------------------
 * A grade é filtrada server-side e atravessa evaluate() uma única vez. Cada
 * célula válida monta um stack em memória e cria um único export de tabela.
 ******************************************************************************/

var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal/forest/v05/0_covariate_source');

var YEAR = 2023;
var CELL_SPLIT = 4;
var TILE_SCALE = 16;
var ASSET_MATRIX = src.ASSET_ROOT + '/MATRIX';
var biome = ee.FeatureCollection(src.BIOME_FC)
  .filter(ee.Filter.eq(src.BIOME_PROP, src.BIOME_NAME)).geometry();
var footprints = ee.FeatureCollection(src.FOOTPRINT_ASSET).filterBounds(biome);
var definitions = src.makeCellDefinitions(CELL_SPLIT);
var definitionById = {};
definitions.forEach(function (cell) { definitionById[cell.id] = cell; });

var cells = src.makeCellFeatures(CELL_SPLIT).map(function (cell) {
  var geom = cell.geometry().intersection(biome, ee.ErrorMargin(30));
  return cell.set({
    valid_area: geom.area(30),
    n_footprints: footprints.filterBounds(geom).size()
  });
}).filter(ee.Filter.gt('valid_area', 0))
  .filter(ee.Filter.gt('n_footprints', 0));

function exportCell(cellId) {
  var definition = definitionById[cellId];
  if (!definition) return;
  var geom = ee.Geometry.BBox(definition.bbox[0], definition.bbox[1],
    definition.bbox[2], definition.bbox[3]).intersection(biome, ee.ErrorMargin(30));
  var points = footprints.filterBounds(geom);
  var stack = src.buildTypedCovariatesStack(geom, YEAR);
  var sampled = stack.sampleRegions({
    collection: points,
    properties: src.SAMPLE_PROPS,
    scale: src.SCALE,
    geometries: true,
    tileScale: TILE_SCALE
  }).filter(ee.Filter.notNull(src.FEATURE_BANDS.concat([src.TARGET])));
  var name = 'agc_matrix_v05_' + cellId + '_' + YEAR;
  Export.table.toAsset({
    collection: sampled,
    description: 'WS_CARBONO_toAsset-' + name,
    assetId: ASSET_MATRIX + '/' + name
  });
}

print('MAPBIOMAS-CARBONO · Pantanal v05 · 2_1_data_matrix');
print('[INFO] Um export por célula · tileScale:', TILE_SCALE);
src.ensureFolder(ASSET_MATRIX);
var validIds = cells.aggregate_array('cell_id');
validIds.evaluate(function (cellIds) {
  print('[OK] Células válidas:', cellIds.length);
  cellIds.forEach(exportCell);
});
