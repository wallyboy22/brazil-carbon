/******************************************************************************
 * MAPBIOMAS-CARBONO — Pantanal v03 · Matriz server-side por célula
 * ---------------------------------------------------------------------------
 * A grade é filtrada no servidor. Um único evaluate() devolve os IDs válidos;
 * os exports são então criados client-side, um por célula.
 ******************************************************************************/
var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal/forest/v03/0_covariate_source');

var YEAR = 2023;
var CELL_SPLIT = 4;
var TILE_SCALE = 16;
var MATRIX = src.ASSET_ROOT + '/MATRIX';
var biome = ee.FeatureCollection(src.BIOME_FC)
  .filter(ee.Filter.eq(src.BIOME_PROP, src.BIOME_NAME)).geometry();
var footprints = ee.FeatureCollection(src.FOOTPRINT_ASSET).filterBounds(biome);
var definitions = src.makeCellDefinitions(CELL_SPLIT);
var definitionById = {};
definitions.forEach(function (cell) { definitionById[cell.id] = cell; });

var cells = src.makeCellFeatures(CELL_SPLIT).map(function (cell) {
  var geom = cell.geometry().intersection(biome, ee.ErrorMargin(30));
  return cell.set({
    valid_area: geom.area(30),
    n_footprints: footprints.filterBounds(geom).size()
  });
}).filter(ee.Filter.gt('valid_area', 0))
  .filter(ee.Filter.gt('n_footprints', 0));

function exportCell(cellId) {
  var def = definitionById[cellId];
  if (!def) return;
  var geom = ee.Geometry.BBox(def.bbox[0], def.bbox[1],
    def.bbox[2], def.bbox[3]).intersection(biome, ee.ErrorMargin(30));
  var sampled = src.buildTypedCovariatesStack(geom, YEAR)
    .sampleRegions({
      collection: footprints.filterBounds(geom),
      properties: src.SAMPLE_PROPS,
      scale: src.SCALE,
      geometries: true,
      tileScale: TILE_SCALE
    }).filter(ee.Filter.notNull(src.FEATURE_BANDS.concat([src.TARGET])));
  var name = 'agc_matrix_v03_' + cellId + '_' + YEAR;
  Export.table.toAsset({
    collection: sampled,
    description: 'WS_CARBONO_toAsset-' + name,
    assetId: MATRIX + '/' + name
  });
}

print('MAPBIOMAS-CARBONO · Pantanal v03 · 2_1_data_matrix');
src.ensureFolder(MATRIX);
cells.aggregate_array('cell_id').evaluate(function (cellIds) {
  print('[OK] Células válidas:', cellIds.length);
  cellIds.forEach(exportCell);
});
