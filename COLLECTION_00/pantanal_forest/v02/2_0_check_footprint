/******************************************************************************
 * MAPBIOMAS-CARBONO — Coleção 0 · PANTANAL · v02 · Validação do footprint
 * ---------------------------------------------------------------------------
 * Subetapa 2.0: valida a entrada persistida da matriz antes de criar tasks.
 * Não exporta nada e não redescobre granules GEDI.
 ******************************************************************************/

var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v02/0_covariate_source');

var YEAR = 2023;
var FOOTPRINT_ASSET = src.ASSET_ROOT + '/SAMPLES/footprint_pantanal_' + YEAR;
var footprints = ee.FeatureCollection(FOOTPRINT_ASSET);

print('MAPBIOMAS-CARBONO · v02 · 2_0_check_footprint · Pantanal');
print('[INFO] Entrada:', FOOTPRINT_ASSET);

footprints.size().evaluate(function (total) {
  if (total === 0) {
    print('[ERRO] O footprint está vazio. Não execute 2_data_matrix.');
    return;
  }
  print('[OK] Footprints:', total);
});

footprints.geometry().bounds().evaluate(function (bounds) {
  print('[OK] Extensão espacial:', bounds);
  print('[OK] Geometrias disponíveis. A entrada está pronta para 2_data_matrix.');
});

footprints.first().propertyNames().evaluate(function (properties) {
  print('[OK] Propriedades da primeira feature:', properties);
});

Map.addLayer(footprints.limit(5000), { color: 'yellow' },
  'Footprints GEDI ' + YEAR, true);
