/******************************************************************************
 * MAPBIOMAS-CARBONO — Coleção 0 · PANTANAL · v02 · Modelagem e predição
 * ---------------------------------------------------------------------------
 * Carrega os assets particionados produzidos por 2_data_matrix, treina o
 * modelo selecionado e exporta a predição anual por tile × parte × ano
 * (evita o 'Computed value is too large' da predição sobre o bioma inteiro).
 ******************************************************************************/

var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v02/0_covariate_source');

// =============================================================================
// CONFIG
// =============================================================================

var VERSION = 'v02';
var SUBVERSION = '_rf';
var MODEL_TYPE = 'rf';
var TARGET = 'agbd';
var ASSET_MATRIX = src.ASSET_ROOT + '/MATRIX';

// Override OPCIONAL dos assets da matriz. Vazio (padrão) = descobre
// automaticamente todos os assets 'agc_matrix_v02_pantanal_*' existentes
// na pasta MATRIX/ (tiles vazios, "Table is empty", não geram asset e são
// ignorados). Preencha somente para restringir o treino a um subconjunto.
var MATRIX_ASSET_IDS = [];

var YEARS = [2019, 2020, 2021, 2022, 2023];
var MODEL_PARAMS = {
  rf: { numberOfTrees: 300, bagFraction: 0.632, seed: 2021 },
  gbm: { numberOfTrees: 300, shrinkage: 0.1, samplingRate: 0.9, seed: 2021 },
  svm: { svmType: 'EPSILON_SVR', kernelType: 'RBF', gamma: 0.01,
    cost: 100, epsilon: 0.1 }
};

var SAVE_MODEL_TO_ASSET = false;
var EXPORT_TO_ASSET = true;
var EXPORT_TO_DRIVE = false;
var EXPORT_FOLDER = 'GEE_Exports_AGC-v02';
var ASSET_PREDICTIONS = src.ASSET_ROOT + '/PREDICTIONS';
var ASSET_MODELS = src.ASSET_ROOT + '/MODELS';

// true = adiciona as predições ao mapa (diagnóstico). false (padrão) = não
// adiciona nada ao mapa.
var ADD_LAYER = false;

// Paleta de diagnóstico usada quando ADD_LAYER=true.
var PRED_PALETTE = ['#d73027', '#fc8d59', '#fee08b', '#d9ef8b', '#91cf60', '#1a9850'];

// Override OPCIONAL dos tiles a predizer. Vazio (padrão) = usa apenas os tiles
// que possuem ao menos um asset de matriz válido. Preencha para testar ou
// limitar, ex.: ['tile01', 'tile02'].
var ACTIVE_TILE_IDS = [];

// Subdivisão de cada tile da matriz em N x N partes para a predição. Reduz a
// carga do Image.classify por task. Se ainda der "Computed value is too large",
// aumente para 3 ou 4.
var PRED_PART_SPLIT = 2;

// =============================================================================
// MATRIZ PARTICIONADA
// =============================================================================

print('[AGUARDE] Carregando os assets da matriz e treinando. Pode levar alguns minutos.');

// Lista, via metadata (sem computação), os assets de matriz existentes na
// pasta MATRIX/. Assets de tiles sem amostra ("Table is empty") não existem
// e são naturalmente ignorados.
// Assinatura correta do GEE: ee.data.listAssets(parent, params, callback),
// com o ID da pasta passado POSICIONALMENTE (não como { parent: ... }).
function listMatrixAssets() {
  var prefix = 'agc_matrix_' + VERSION + '_pantanal_';
  var listing = ee.data.listAssets(ASSET_MATRIX);
  var ids = [];
  (listing.assets || []).forEach(function (a) {
    var name = a.id.split('/').pop();
    if (name.indexOf(prefix) === 0 && a.type === 'TABLE') {
      ids.push(a.id);
    }
  });
  ids.sort();
  return ids;
}

var matrixAssets = MATRIX_ASSET_IDS.length > 0 ? MATRIX_ASSET_IDS : listMatrixAssets();
if (matrixAssets.length === 0) {
  print('[ERRO] Nenhum asset de matriz encontrado em', ASSET_MATRIX,
    '. Execute 2_data_matrix (e confira os que completaram) antes do 3_modelling.');
  throw new Error('Matriz vazia: nenhum asset de matriz disponível.');
}

var matrix = ee.FeatureCollection(matrixAssets.map(function (asset) {
  return ee.FeatureCollection(asset);
})).flatten();

print('[OK] Assets da matriz (' + matrixAssets.length + '):', matrixAssets);
matrix.size().evaluate(function (n) { print('[OK] Amostras:', n); });

var EXCLUDE_PROPS = [
  'agbd', 'agbd_se', 'agbd_pi_lower', 'agbd_pi_upper',
  'sensitivity', 'beam', 'selected_algorithm', 'pft_class',
  'region_class', 'landsat_treecover', 'shot_number', 'delta_time',
  'lon_lowestmode', 'lat_lowestmode', 'system:index'
];
var inputProps = ee.Feature(matrix.first()).propertyNames()
  .removeAll(EXCLUDE_PROPS);
print('[OK] Covariáveis:', inputProps);

function buildModel() {
  if (MODEL_TYPE === 'rf') {
    return ee.Classifier.smileRandomForest(MODEL_PARAMS.rf)
      .setOutputMode('REGRESSION');
  }
  if (MODEL_TYPE === 'gbm') {
    return ee.Classifier.smileGradientTreeBoost(MODEL_PARAMS.gbm)
      .setOutputMode('REGRESSION');
  }
  if (MODEL_TYPE === 'svm') {
    return ee.Classifier.libsvm(MODEL_PARAMS.svm)
      .setOutputMode('REGRESSION');
  }
  throw new Error('MODEL_TYPE inválido: ' + MODEL_TYPE);
}

var model = buildModel().train({
  features: matrix,
  classProperty: TARGET,
  inputProperties: inputProps
});
print('[OK] Modelo treinado:', MODEL_TYPE, '· subversão:', SUBVERSION);

if (MODEL_TYPE !== 'svm') {
  model.explain().evaluate(function (exp) {
    if (exp && exp.importance) {
      var pairs = Object.keys(exp.importance).map(function (key) {
        return [exp.importance[key], key];
      });
      pairs.sort(function (a, b) { return b[0] - a[0]; });
      print('[OK] Importância (top 15):', pairs.slice(0, 15));
    } else {
      print('[AVISO] model.explain() não retornou importance — pulando diagnóstico.');
    }
  });
}

if (SAVE_MODEL_TO_ASSET) {
  src.ensureFolder(ASSET_MODELS);
  Export.classifier.toAsset({
    classifier: model,
    description: 'WS_CARBONO_toAsset-' + MODEL_TYPE + '_agc_' + VERSION + SUBVERSION,
    assetId: ASSET_MODELS + '/' + MODEL_TYPE + '_agc_' + VERSION + SUBVERSION
  });
}

// =============================================================================
// PREDIÇÃO E EXPORTS — por tile × parte × ano
// =============================================================================

// Malha espacial idêntica à do 2_data_matrix (mantida em sincronia).
var X_EDGES = [-60.678789762675464, -58.646318, -56.613847,
  -54.581376, -52.548906950175464];
var Y_EDGES = [-22.813804973745906, -20.350024, -17.886244,
  -15.422463, -12.958681301038263];

var TILE_BBOX = {};
for (var ty = 0; ty < Y_EDGES.length - 1; ty++) {
  for (var tx = 0; tx < X_EDGES.length - 1; tx++) {
    var tileId = 'tile' + ('00' + (ty * 4 + tx + 1)).slice(-2);
    TILE_BBOX[tileId] = [X_EDGES[tx], Y_EDGES[ty], X_EDGES[tx + 1], Y_EDGES[ty + 1]];
  }
}

// Descobre os tiles que possuem ao menos um asset de matriz (nome do asset
// contém 'tileNN').
function activeTileIds() {
  var found = {};
  matrixAssets.forEach(function (aid) {
    var m = aid.match(/tile\d\d/);
    if (m) found[m[0]] = true;
  });
  return Object.keys(found).sort();
}

// Divide o bbox do tile em PRED_PART_SPLIT × PRED_PART_SPLIT partes.
function splitTile(bb) {
  var parts = [];
  var S = PRED_PART_SPLIT;
  for (var i = 0; i < S; i++) {
    for (var j = 0; j < S; j++) {
      parts.push({
        id: 'p' + ('00' + (i * S + j + 1)).slice(-2),
        bbox: [
          bb[0] + (bb[2] - bb[0]) * j / S,
          bb[1] + (bb[3] - bb[1]) * i / S,
          bb[0] + (bb[2] - bb[0]) * (j + 1) / S,
          bb[1] + (bb[3] - bb[1]) * (i + 1) / S
        ]
      });
    }
  }
  return parts;
}

var biomeGeom = ee.FeatureCollection(src.BIOME_FC)
  .filter(ee.Filter.eq(src.BIOME_PROP, src.BIOME_NAME))
  .geometry();
var suffix = VERSION + SUBVERSION;

if (EXPORT_TO_ASSET) src.ensureFolder(ASSET_PREDICTIONS);

var tileIds = ACTIVE_TILE_IDS.length > 0 ? ACTIVE_TILE_IDS : activeTileIds();
if (tileIds.length === 0) {
  print('[ERRO] Nenhum tile ativo para predizer. Verifique a matriz ou preencha ACTIVE_TILE_IDS.');
  throw new Error('Sem tiles ativos para predição.');
}
print('[INFO] Tiles da predição (' + tileIds.length + '):', tileIds.join(', '));

var nTaskCount = 0;
tileIds.forEach(function (tileId) {
  var bb = TILE_BBOX[tileId];
  if (!bb) {
    print('[AVISO] Tile desconhecido, pulando:', tileId);
    return;
  }
  splitTile(bb).forEach(function (part) {
    var partGeom = ee.Geometry.BBox(
      part.bbox[0], part.bbox[1], part.bbox[2], part.bbox[3])
      .intersection(biomeGeom, ee.ErrorMargin(30));

    YEARS.forEach(function (year) {
      var stackYear = src.buildCovariatesStack(partGeom, year);
      var predYear = stackYear.classify(model)
        .rename('prediction_' + year).round().int16().clip(partGeom);
      var tag = tileId + '_' + part.id + '_' + year;

      if (ADD_LAYER) {
        Map.addLayer(predYear,
          { min: 0, max: 150, palette: PRED_PALETTE },
          'AGC ' + tag, false);
      }

      if (EXPORT_TO_ASSET) {
        Export.image.toAsset({
          image: predYear,
          description: 'WS_CARBONO_toAsset-agc_pred_' + suffix + '_' + tag,
          assetId: ASSET_PREDICTIONS + '/agc_pred_' + suffix + '_' + tag,
          region: partGeom,
          scale: src.SCALE,
          maxPixels: 1e13,
          pyramidingPolicy: { '.default': 'mean' }
        });
        nTaskCount++;
      }

      if (EXPORT_TO_DRIVE) {
        Export.image.toDrive({
          image: predYear,
          description: 'WS_CARBONO_toDrive-agc_pred_' + suffix + '_' + tag,
          folder: EXPORT_FOLDER,
          fileNamePrefix: 'agc_pred_' + suffix + '_' + tag,
          region: partGeom,
          scale: src.SCALE,
          maxPixels: 1e13
        });
      }
    });
  });
});

print('MAPBIOMAS-CARBONO · v02 · 3_modelling · Pantanal · modelo ' + MODEL_TYPE +
  ' · assets ' + matrixAssets.length + ' · tiles ' + tileIds.length +
  ' · partes ' + (PRED_PART_SPLIT * PRED_PART_SPLIT) +
  ' · anos ' + YEARS.join(',') + ' · tasks de Asset ' + nTaskCount);
