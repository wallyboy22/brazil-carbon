var c = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v06/0_contract');
var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v06/0_covariate_source');
var CELL_SPLIT = 4;
var TILE_SCALE = 16;
var matrixRoot = c.ASSET_ROOT + '/MATRIX';
var biome = src.getBiome().geometry();
var points = ee.FeatureCollection(c.ASSET_ROOT + '/SAMPLES/forest_footprint_v06_' + c.YEAR);
var defs = c.makeCellDefinitions(CELL_SPLIT);
var byId = {};
defs.forEach(function (cell) { byId[cell.id] = cell; });
var cells = c.makeCellFeatures(CELL_SPLIT).map(function (cell) {
  var geom = cell.geometry().intersection(biome, ee.ErrorMargin(30));
  return cell.set({ valid_area: geom.area(30), n_points: points.filterBounds(geom).size() });
}).filter(ee.Filter.gt('valid_area', 0)).filter(ee.Filter.gt('n_points', 0));

function exportCell(id) {
  var def = byId[id];
  var geom = ee.Geometry.BBox(def.bbox[0], def.bbox[1], def.bbox[2], def.bbox[3])
    .intersection(biome, ee.ErrorMargin(30));
  var sampled = src.buildTypedCovariatesStack(geom, c.YEAR).sampleRegions({
    collection: points.filterBounds(geom), properties: src.SAMPLE_PROPS,
    scale: c.SCALE, geometries: true, tileScale: TILE_SCALE
  }).filter(ee.Filter.notNull(c.FEATURE_BANDS.concat([c.TARGET])));
  var name = 'agc_matrix_v06_' + id + '_' + c.YEAR;
  Export.table.toAsset({ collection: sampled,
    description: 'WS_CARBONO_toAsset-' + name, assetId: matrixRoot + '/' + name });
}

print('MAPBIOMAS-CARBONO · Pantanal Forest v06 · 2_2_data_matrix');
src.ensureFolder(matrixRoot);
cells.aggregate_array('cell_id').evaluate(function (ids) {
  print('[CÉLULAS]', ids.length); ids.forEach(exportCell);
});
