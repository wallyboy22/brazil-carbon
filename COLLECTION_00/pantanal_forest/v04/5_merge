/******************************************************************************
 * MAPBIOMAS-CARBONO — Pantanal v04 · Merge anual
 ******************************************************************************/

var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v04/0_covariate_source');
var PREDICTION_ROOT = src.ASSET_ROOT + '/PREDICTIONS';
var YEARS = [2019, 2020, 2021, 2022, 2023];
var response = ee.data.listAssets(PREDICTION_ROOT);
var assets = (response.assets || []).filter(function (asset) {
  return asset.type === 'IMAGE' && asset.id.indexOf('/agc_pred_v04_') > -1 &&
    asset.id.indexOf('_merged_') === -1;
});

var region = ee.FeatureCollection(src.BIOME_FC)
  .filter(ee.Filter.eq(src.BIOME_PROP, src.BIOME_NAME)).geometry();
print('MAPBIOMAS-CARBONO · Pantanal v04 · 5_merge');

YEARS.forEach(function (year) {
  var yearAssets = assets.filter(function (asset) {
    return asset.id.slice(-4) === String(year);
  });
  if (!yearAssets.length) {
    print('[SKIP] Sem predição:', year);
    return;
  }
  var mosaic = ee.ImageCollection(yearAssets.map(function (asset) {
    return ee.Image(asset.id);
  })).mosaic().toFloat().rename('prediction_' + year);
  Export.image.toAsset({
    image: mosaic,
    description: 'WS_CARBONO_toAsset-agc_pred_v04_merged_' + year,
    assetId: PREDICTION_ROOT + '/agc_pred_v04_merged_' + year,
    region: region,
    scale: src.SCALE,
    maxPixels: 1e13,
    pyramidingPolicy: { '.default': 'mean' }
  });
  print('[TASK] Merge:', year, '· partes:', yearAssets.length);
});
