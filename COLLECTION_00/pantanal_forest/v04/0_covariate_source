exports.buildTypedCovariatesStack = function (aoi, year) {
  var raw = base.buildTypedCovariatesStack(aoi, year);
  return raw.select(contract.CONTINUOUS_BANDS).toFloat()
    .addBands(raw.select(contract.CATEGORICAL_BANDS).toUint8())
    .select(contract.FEATURE_BANDS)
    .clip(aoi);
};
