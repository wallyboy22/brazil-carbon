exports.ASSET_ROOT = contract.ASSET_ROOT;
exports.FOOTPRINT_ASSET = contract.FOOTPRINT_ASSET;
exports.BIOME_FC = base.BIOME_FC;
exports.BIOME_PROP = base.BIOME_PROP;
