var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v05/0_covariate_source');
var YEAR = 2023;
var biome = ee.FeatureCollection(src.BIOME_FC)
  .filter(ee.Filter.eq(src.BIOME_PROP, src.BIOME_NAME));
var aoi = biome.geometry().bounds();
var stack = src.buildTypedCovariatesStack(aoi, YEAR);

print('MAPBIOMAS-CARBONO · Pantanal v05 · 1_preflight');
print('[BANDAS]', stack.bandNames());
print('[TIPOS]', stack.bandTypes());
stack.bandTypes().evaluate(function (types) {
  var doubles = [];
  Object.keys(types || {}).forEach(function (band) {
    if (types[band] && types[band].precision === 'double') doubles.push(band);
  });
  print(doubles.length ? '[ERRO] Double:' : '[OK] Sem Double:', doubles);
});
stack.sampleRegions({
  collection: ee.FeatureCollection.randomPoints(aoi, 10, 2025),
  properties: [], scale: src.SCALE, geometries: true, tileScale: 16
}).size().evaluate(function (n) { print('[AMOSTRAS]', n); });
