var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v05/0_covariate_source');
var ROOT = src.ASSET_ROOT;
var response = ee.data.listAssets(ROOT + '/MATRIX');
var assets = (response.assets || []).filter(function (a) {
  return a.type === 'TABLE' && a.id.indexOf('/agc_matrix_v05_') > -1;
});
if (!assets.length) throw new Error('Nenhuma matriz v05 encontrada.');
var matrix = ee.FeatureCollection(assets.map(function (a) {
  return ee.FeatureCollection(a.id);
})).flatten().select(src.FEATURE_BANDS.concat([src.TARGET]));
var model = ee.Classifier.smileRandomForest({
  numberOfTrees: 300, bagFraction: 0.632, seed: 2021
}).setOutputMode('REGRESSION').train({
  features: matrix, classProperty: src.TARGET, inputProperties: src.FEATURE_BANDS
});
var modelAsset = ROOT + '/MODELS/rf_agc_v05';
print('MAPBIOMAS-CARBONO · Pantanal v05 · 3_model_training');
print('[MATRIZES]', assets.length, '· [FEATURES]', src.FEATURE_BANDS.length);
matrix.size().evaluate(function (n) { print('[AMOSTRAS]', n); });
src.ensureFolder(ROOT + '/MODELS');
Export.classifier.toAsset({
  classifier: model,
  description: 'WS_CARBONO_toAsset-rf_agc_v05',
  assetId: modelAsset
});
print('[TASK] Modelo:', modelAsset);
