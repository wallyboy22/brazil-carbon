/******************************************************************************
 * MAPBIOMAS-CARBONO — Coleção 0 · PANTANAL · v01 · Checagem de covariáveis
 * ----------------------------------------------------------------------------
 * Diagnóstico da etapa 1: carrega o módulo 0_covariate_source, monta o stack
 * do ano configurado e valida (sem exportar nada):
 *   - nº de bandas do stack;
 *   - camadas de diagnóstico no mapa (NDVI_p50, HH_db, LULC C11, limite);
 *   - teste de sampleRegions em 3 pontos aleatórios dentro do AOI.
 *
 * ORDEM DA PIPELINE v01:
 *   0_covariate_source → [1_check_covariates] → 2_data_matrix → 3_modelling
 ******************************************************************************/

var src = require(
  'users/workspaceipam/mapbiomas-carbono:COLLECTION_00/pantanal_forest/v01/0_covariate_source');

// =============================================================================
// CONFIG
// =============================================================================

// Ano de referência do stack (deve ter HLS + PALSAR disponíveis; GEDI: 2019+)
var YEAR = 2023;

// AOI padrão: bioma completo (mesma fonte da predição em 3_modelling)
var biomeFc = ee.FeatureCollection(src.BIOME_FC)
  .filter(ee.Filter.eq(src.BIOME_PROP, src.BIOME_NAME));
var aoi = biomeFc.geometry().bounds();

// =============================================================================
// 1. STACK — contagem e nomes das bandas
// =============================================================================

var stack = src.buildCovariatesStack(aoi, YEAR);

stack.bandNames().evaluate(function (bands) {
  print('[OK] Stack ' + YEAR + ':', bands.length, 'bandas');
  print('[OK] Bandas:', bands);
});

// =============================================================================
// 2. CAMADAS DE DIAGNÓSTICO
// =============================================================================

Map.addLayer(stack.select('NDVI_p50'), { min: 0, max: 9000 }, 'NDVI_p50', false);
Map.addLayer(stack.select('HH_db'), { min: -25, max: 0 }, 'PALSAR HH_db', false);
Map.addLayer(stack.select('HAND_m'), { min: 0, max: 100 }, 'HAND_m', false);

// LULC Coleção 11 (viz completa + legenda copiável na seção 7 do v00)
var lulc = ee.Image(
  'projects/mapbiomas-public/assets/brazil/lulc/collection11/'
  + 'mapbiomas_brazil_collection11_coverage_v3')
  .select('classification_' + YEAR);
Map.addLayer(lulc, { min: 0, max: 91,
  palette: ['000000', '1f8d49'] }, 'MapBiomas LULC Col 11 (' + YEAR + ')', false);
Map.addLayer(biomeFc, { color: 'red' }, 'Limite Pantanal', true);

// =============================================================================
// 3. TESTE sampleRegions — 3 pontos aleatórios no AOI
// =============================================================================

var testPoints = ee.FeatureCollection.randomPoints(aoi, 3, 42);
var testSample = stack.sampleRegions({
  collection: testPoints,
  properties: [],
  scale: src.SCALE,
  geometries: false,
  tileScale: 8
});

testSample.evaluate(function (sample) {
  var nProps = sample.features.length ? Object.keys(sample.features[0].properties).length : 0;
  print('[DEBUG] sampleRegions(3) — features:', sample.features.length,
    '· propriedades por feature:', nProps);
});

print('MAPBIOMAS-CARBONO · v01 · 1_check_covariates · Pantanal · ano ' + YEAR);
